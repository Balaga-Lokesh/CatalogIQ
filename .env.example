# Copy to .env and adjust. Never commit the real .env file.

# "mock" or the name of the real provider (decided later)
LLM_PROVIDER=mock

# Max LLM calls in progress at the same time, across ALL jobs
LLM_CONCURRENCY=5

# Mock provider behaviour
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0.1

# SQLite file location
DB_PATH=catalogiq.db

# Real provider API key (only if the chosen provider needs one)
# LLM_API_KEY=
