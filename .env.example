# Example settings. Copy this file to .env (git-ignored) and fill it in, or set
# the same names as real environment variables (those win over .env).
# Never commit real API keys.

# mock | groq | ollama | openrouter | gemini
LLM_PROVIDER=mock

# Max LLM calls in progress at the same time, across ALL jobs
LLM_CONCURRENCY=5

# Mock provider behaviour
MOCK_LATENCY_MS=200
MOCK_FAILURE_RATE=0.1

# SQLite file location
DB_PATH=catalogiq.db

# ---- real provider (ignored in mock mode) ----
# The key can be given as LLM_API_KEY or the provider's own variable:
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_TIMEOUT_S=30
# Max LLM calls started per minute (0 = no limit). groq defaults to 14 (free tier).
# LLM_MAX_RPM=14
